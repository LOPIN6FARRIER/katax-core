{
  "name": "katax-core",
  "version": "1.6.4",
  "description": "Lightweight and extensible schema validation library for TypeScript/JavaScript",
  "keywords": [
    "validation",
    "schema",
    "typescript",
    "type-safe",
    "validator",
    "parsing",
    "runtime-validation",
    "async-validation",
    "zod-alternative"
  ],
  "homepage": "https://github.com/LOPIN6FARRIER/katax-core#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LOPIN6FARRIER/katax-core.git"
  },
  "bugs": {
    "url": "https://github.com/LOPIN6FARRIER/katax-core/issues"
  },
  "author": "Vinicio Esparza",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts",
    "dev": "tsup src/index.ts --watch",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build && npm test",
    "test-jsonschema": "vitest tests/jsonschema.test.ts"
  },
  "devDependencies": {
    "@types/node": "^25.1.0",
    "eslint": "^9.39.2",
    "prettier": "^3.7.4",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.9"
  },
  "dependencies": {
    "date-fns": "^4.1.0"
  }
}
